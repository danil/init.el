;;; Corral is an Smartparens replacement
;;; (quotes/parentheses/delimiters manager).

(defgroup init-corral nil
  "init-corral"
  :group  'editing
  :tag    "init-corral"
  :prefix "init-corral-"
  :link   '(url-link :tag "GitHub" "https://github.com/danil/init.el"))

(defcustom init-corral-mode-lighter " init-corral" "init-corral" :group 'init-corral)

(defvar init-corral-mode-map (make-sparse-keymap) "init-corral")

(define-minor-mode init-corral-mode "init-corral" :init-value nil :lighter init-corral-mode-lighter :keymap init-corral-mode-map
  (init-corral-setup))

(define-globalized-minor-mode init-global-corral-mode init-corral-mode
  init-global-corral-setup
  ;; (unless init-global-corral-mode (init-global-corral-teardown))
  )

(defun init-corral-setup ()
  (let ((map init-corral-mode-map))
    (define-key map (kbd "M-x M-x p (") 'corral-parentheses-backward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p )") 'corral-parentheses-forward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p [") 'corral-brackets-backward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p ]") 'corral-brackets-forward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p {") 'corral-braces-backward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p }") 'corral-braces-forward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p \" b") 'corral-double-quotes-backward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p \" f") 'corral-double-quotes-forward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p ' b") 'corral-single-quotes-backward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "M-x M-x p ' f") 'corral-single-quotes-forward) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    ))

(defun init-global-corral-setup () (init-corral-mode +1))
;; (defun init-global-corral-teardown ())

(provide 'init-corral)
