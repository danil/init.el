(defgroup init-emacs-lisp-mode nil
  "init-emacs-lisp-mode"
  :group  'editing
  :tag    "init-emacs-lisp-mode"
  :prefix "init-emacs-lisp-mode-"
  :link   '(url-link :tag "GitHub" "https://github.com/danil/init.el"))

(defcustom init-emacs-lisp-mode-patterns '()
  "Regexp patterns associated with `emacs-lisp-mode'."
  :group 'init-emacs-lisp-mode)

(defun init-emacs-lisp-mode ()
  (dolist (p init-emacs-lisp-mode-patterns)
    (add-to-list 'auto-mode-alist (cons p 'emacs-lisp-mode)))

  (if (boundp 'emacs-lisp-mode-map) (noxrcp-emacs-lisp-mode--init)
    (with-eval-after-load 'elisp-mode (noxrcp-emacs-lisp-mode--init))))

(defun noxrcp-emacs-lisp-mode--init ()
  (let ((map emacs-lisp-mode-map))
    (define-key map (kbd "C-c C-f") nil) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "C-c C-f n") 'beginning-of-defun) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "C-x C-x ! b") 'init-emacs-lisp-mode-eval-buffer) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "C-x C-x ! r") 'init-emacs-lisp-mode-eval-region) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    (define-key map (kbd "C-M-i") nil) ; FIXME: ????????????????????????????????????????????????????????????????????????????????
    ))

(defun init-emacs-lisp-mode-eval-buffer ()
  (interactive)
  (message (format "Eval: %s" (buffer-name)))
  (eval-buffer))

(defun init-emacs-lisp-mode-eval-region (start end)
  (interactive "r")
  (message "Eval region")
  (eval-region start end))

(provide 'init-emacs-lisp-mode)
