(defun init-evil-collection ()
  (if (boundp 'evil-normal-state-map) (init-evil-collection-init)
    (with-eval-after-load 'evil (init-evil-collection-init))))

(defun init-evil-collection-init ()
  (if (require 'evil-collection nil t)
      (init-evil-collection--init)
    (error "evil-collection load failure")))

